# Set these server-side only; never place either key in frontend assets.
VIDEOSCOPE_ACCESS_KEY=replace-with-a-random-key-at-least-20-characters
VIDEOSCOPE_SECRET_KEY=replace-with-a-random-key-at-least-32-characters
VIDEOSCOPE_ALLOWED_ORIGINS=https://videoscope-3-tahmid.netlify.app
VIDEOSCOPE_DATA_DIR=/data
VIDEOSCOPE_MAX_FILE_BYTES=1073741824
VIDEOSCOPE_DISK_BUDGET_BYTES=4294967296
VIDEOSCOPE_CONCURRENCY=1
VIDEOSCOPE_JOB_TIMEOUT=1200
VIDEOSCOPE_RETENTION_SECONDS=3600
# Netlify Functions must additionally receive VIDEOSCOPE_MEDIA_API=https://YOUR-BACKEND
# and the same VIDEOSCOPE_SECRET_KEY. No media bytes pass through Netlify.

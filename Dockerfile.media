FROM denoland/deno:bin AS deno
FROM python:3.12-slim-bookworm
COPY --from=deno /deno /usr/local/bin/deno
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-media.txt ./
RUN pip install --no-cache-dir -r requirements-media.txt
COPY media_api ./media_api
RUN useradd --create-home --uid 10001 videoscope && mkdir -p /data && chown videoscope:videoscope /data
USER videoscope
ENV PYTHONUNBUFFERED=1 VIDEOSCOPE_DATA_DIR=/data
EXPOSE 8000
CMD ["sh","-c","uvicorn media_api.gateway:create_app --factory --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --no-access-log"]
